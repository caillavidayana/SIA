# Configuración de reglas para desarrollo. No contiene credenciales.
# 1. CAJA CHICA (R01): ejemplo 1500; reiniciar Django.
SIA_LIMITE_CAJA_CHICA=1500
# 2. COTIZACIONES (R02): ejemplo umbral 800; independiente de R01.
SIA_UMBRAL_COTIZACIONES=500
SIA_COTIZACIONES_MINIMAS=3
SIA_PROVEEDORES_DISTINTOS=True
# 4. TIEMPOS DE ATENCION (R04): horas Alta/Media/Baja.
SIA_SLA_ALTA_HORAS=4
SIA_SLA_MEDIA_HORAS=24
SIA_SLA_BAJA_HORAS=72
SIA_SLA_CRITICA_HORAS=4
# 6. REAPERTURA (R06): ejemplo 10 dias.
SIA_HORAS_REAPERTURA=7
# 7. CARGA DEL TECNICO (R07): ejemplo 8 casos activos.
SIA_MAX_TICKETS_TECNICO=5
SIA_UMBRAL_APROBACION_ADMINISTRATIVA=300
SIA_GRUPO_APROBADOR=Jefe administrativo
# 9. FONDO Y SALDO (R09): ejemplo 7000.
SIA_FONDO_MENSUAL=5500
# 8. APROBACION DE COMPRA (R08): False mantiene flujo sin Director.
SIA_REQUIERE_APROBACION_DIRECTOR=False
